// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum MessageStatus {
  DRAFT
  READY
  SENT
}

enum HealthRoutineKind {
  WALK
  EXERCISE
  DIET
  SLEEP
  WATER
  MEDITATION
  OTHER
}

enum MoneyDirection {
  GIVEN
  OWED
}

model User {
  id                String             @id
  email             String             @unique
  name              String?
  projects          Project[]
  taskComments      TaskComment[]
  todos             Todo[]
  queuedMessages    QueuedMessage[]
  pushSubscriptions PushSubscription[]
  eodEntries          EodEntry[]
  healthRoutines      HealthRoutine[]
  healthLogs          HealthLog[]
  healthPrescriptions HealthPrescription[]
  healthCheckIns      HealthCheckIn[]
  healthSymptoms      HealthSymptom[]
  healthMedications   HealthMedication[]
  healthJourneyInsights HealthJourneyInsight[]
  spendEntries        SpendEntry[]
  moneyLoans          MoneyLoan[]
  monthlyBudgets      MonthlyBudget[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Todo {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                   String
  completed               Boolean  @default(false)
  reminderAt              DateTime?
  reminderClaimedAt       DateTime?
  reminderSentAt          DateTime?
  emailReminderSentAt     DateTime?
  pushReminderSentAt      DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId, completed])
  @@index([reminderAt, completed, reminderSentAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Project {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  clientName     String?
  color          String            @default("#7c3aed")
  status         ProjectStatus     @default(ACTIVE)
  tasks          Task[]
  clientMessages ClientMessage[]
  queuedMessages QueuedMessage[]
  eodEntries     ProjectEodEntry[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Task {
  id            String     @id @default(cuid())
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  screenshotUrl String?
  workDate      DateTime   @db.Date
  hoursWorked   Float?
  status        TaskStatus @default(NOT_STARTED)
  sortOrder     Int        @default(0)
  comments      TaskComment[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([projectId, workDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([userId])
}

model ClientMessage {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content    String
  senderName String?
  receivedAt DateTime @default(now())
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([projectId, receivedAt])
  @@index([projectId, resolvedAt])
}

model QueuedMessage {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  content     String
  status      MessageStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, status])
  @@index([projectId, status])
}

model EodEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryDate   DateTime @db.Date
  summary     String
  blockers    String?
  tomorrow    String?
  hoursWorked Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, entryDate])
}

model HealthRoutine {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      HealthRoutineKind
  title     String
  target    String?
  archived  Boolean            @default(false)
  logs      HealthLog[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, archived])
}

model HealthLog {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId String
  routine   HealthRoutine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  logDate   DateTime       @db.Date
  completed Boolean        @default(true)
  amount    String?
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([routineId, logDate])
  @@index([userId, logDate])
}

model HealthPrescription {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorName  String?
  visitDate   DateTime              @db.Date
  advice      String
  medications String?
  nextVisitAt DateTime?             @db.Date
  updates     HealthProgressNote[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([userId, visitDate])
}

model HealthProgressNote {
  id             String             @id @default(cuid())
  prescriptionId String
  prescription   HealthPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  noteDate       DateTime           @db.Date
  improving      String
  stillIssue     String?
  createdAt      DateTime           @default(now())

  @@index([prescriptionId, noteDate])
}

model HealthCheckIn {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate      DateTime @db.Date
  sleepHours   Float?
  sleepQuality Int?
  waterGlasses Int      @default(0)
  mood         Int?
  energy       Int?
  weightKg     Float?
  systolic     Int?
  diastolic    Int?
  heartRate    Int?
  bloodSugar   Float?
  temperature  Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, logDate])
}

model HealthSymptom {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate   DateTime @db.Date
  name      String
  severity  Int
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, logDate])
}

model HealthMedication {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  dose      String?
  schedule  String?
  active    Boolean                @default(true)
  logs      HealthMedicationLog[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([userId, active])
}

model HealthMedicationLog {
  id            String           @id @default(cuid())
  medicationId  String
  medication    HealthMedication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  logDate       DateTime         @db.Date
  taken         Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([medicationId, logDate])
}

model HealthJourneyInsight {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate      DateTime @db.Date
  headline     String
  comparison   String
  direction    String
  attention    String
  suggestions  Json
  changed      Json?
  helping      String?
  hurting      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, logDate])
  @@index([userId, createdAt])
}

model SpendEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spentAt   DateTime @db.Date
  name      String
  amount    Float
  category  String?
  createdAt DateTime @default(now())

  @@index([userId, spentAt])
}

model MoneyLoan {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction   MoneyDirection
  personName  String
  amount      Float
  note        String?
  settled     Boolean        @default(false)
  loggedAt    DateTime       @db.Date
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, direction, settled])
}

model MonthlyBudget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     DateTime @db.Date
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
}

model ProjectEodEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entryDate DateTime @db.Date
  summary   String
  blockers  String?
  tomorrow  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, entryDate])
}
